{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/tiktok(.*).txt", "destination": "/tiktok$1.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
